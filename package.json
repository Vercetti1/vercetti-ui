{
  "name": "vercetti-ui-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @vercetti/docs",
    "build:ui": "npm run build --workspace @vercetti/ui",
    "build": "npm run build:ui && npm run build --workspace @vercetti/docs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "preview": "npm run preview --workspace @vercetti/docs"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
